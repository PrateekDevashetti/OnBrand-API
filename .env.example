# ---------- OnBrand API by Canopy Labs ----------
# Postgres (Railway Postgres / Neon / local). Required everywhere.
DATABASE_URL=postgres://user:pass@host:5432/onbrand

# Claude (synthesis, adherence critique, prompt enhancer, deep search rerank).
# Without a key the engine still works on its deterministic synthesizer.
ANTHROPIC_API_KEY=
ONBRAND_MODEL=claude-opus-5-5
# Optional: an Anthropic-Messages-compatible gateway instead of the direct API
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ONBRAND_LLM_AUTH_TOKEN=

# Engine: "inline" runs jobs in the web process (local / single box);
# "worker" queues them for apps/worker (use this on Vercel + Railway).
ONBRAND_ENGINE_MODE=inline
WORKER_CONCURRENCY=3
# CHROMIUM_PATH=            # optional; auto-detected from the Playwright cache

# Artifacts (screenshots, html, css). Local disk by default.
ONBRAND_STORAGE_DIR=./storage
# Shared object storage (required when web and worker run on different machines):
# S3_BUCKET=onbrand
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Optional: Firecrawl screenshots when no Chromium is available (fetch-only fallback)
FIRECRAWL_API_KEY=

# Auth (Clerk). Leave empty to run single-user dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_SKILLS_REPO=PrateekDevashetti/OnBrand-API

# Credits
ONBRAND_SIGNUP_CREDITS=20
# ONBRAND_ALLOW_TEST_CREDITS=true   # enables "Add 50 test credits" with Clerk on (staging only)
