{
  "name": "onbrand-api",
  "private": true,
  "version": "0.1.0",
  "description": "OnBrand API by Canopy Labs — the brand layer for AI agents.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @onbrand/web",
    "dev:worker": "npm run dev -w @onbrand/worker",
    "build": "npm run build -w @onbrand/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push -w @onbrand/core",
    "db:seed": "npm run db:seed -w @onbrand/core",
    "start": "npm run start -w @onbrand/worker",
    "e2e": "e2e run"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.12.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "e2e": "^0.17.0",
    "railway": "^3.13.0"
  }
}
