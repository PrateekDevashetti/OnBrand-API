  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "The API never crawls in worker mode: it debits, writes the row and a job, and answers 202",
        "The Railway worker owns all slow work: capture, R2 upload, six parallel Claude calls",
        "Each section is merged into the row as it lands, so /result can return partial data early"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "Unsafe or private URLs are rejected before any request (SSRF guard)",
        "A failed AI section falls back to the deterministic measured engine",
        "Jobs stuck past 12 min are failed and their credits refunded; jobs locked >15 min are re-claimed (max 3 attempts)"
      ]
    },
    {
      "dot": "amber",
      "title": "Known limits",
      "items": [
        "Clients poll; there are no webhooks or push updates yet",
        "One worker service with 3 slots and no per-account fairness in the queue",
        "Inline mode (no worker) runs the same steps inside the web function, used for local dev"
      ]
    }
  ]
